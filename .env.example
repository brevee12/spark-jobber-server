# Jobber OAuth app credentials (from Developer Center)
JOBBER_CLIENT_ID=
JOBBER_CLIENT_SECRET=

# Must match a Redirect URL registered on your Jobber app
# Local:  http://localhost:3001/oauth/callback
# Render: https://YOUR-SERVICE.onrender.com/oauth/callback
JOBBER_REDIRECT_URI=http://localhost:3001/oauth/callback

# Optional: pin API version (Jobber date-based versions)
JOBBER_GRAPHQL_VERSION=2025-04-16

# Optional: seed tokens after first OAuth (usually written to .jobber-tokens.json instead)
# JOBBER_ACCESS_TOKEN=
# JOBBER_REFRESH_TOKEN=

PORT=3001
