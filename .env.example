# --- Jobber ---
JOBBER_CLIENT_ID=
JOBBER_CLIENT_SECRET=
# Local:  http://localhost:3001/oauth/callback
# Render: https://spark-jobber-server.onrender.com/oauth/callback
JOBBER_REDIRECT_URI=https://spark-jobber-server.onrender.com/oauth/callback
JOBBER_GRAPHQL_VERSION=2025-04-16

# --- SimpleFIN Bridge (read-only bank feeds) ---
# One-time setup token from https://bridge.simplefin.org/simplefin/create
# After claim, prefer storing the permanent access URL instead:
SIMPLEFIN_SETUP_TOKEN=
SIMPLEFIN_ACCESS_URL=

# --- QuickBooks Online (Intuit OAuth 2.0) ---
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
# Must match Redirect URI in Intuit Developer app
# Local:  http://localhost:3001/qbo/callback
# Render: https://spark-jobber-server.onrender.com/qbo/callback
QBO_REDIRECT_URI=https://spark-jobber-server.onrender.com/qbo/callback
# production | sandbox
QBO_ENVIRONMENT=production
# Optional overrides
# QBO_SHERWIN_VENDOR_ID=24
# QBO_CC_ACCOUNT_IDS=85,86
# QBO_CASH_ACCOUNT_NAMES=Checking-Marion County Bank (3696)|N/P-Marion County Bank (LOC 0549-100)
# QBO_MINOR_VERSION=75

# Optional: seed long-lived tokens on Render (ephemeral disk otherwise)
# Prefer refresh tokens — access tokens are short-lived and restored on boot.
# JOBBER_REFRESH_TOKEN=
# QBO_REFRESH_TOKEN=
# QBO_REALM_ID=
# QBO_REFRESH_EXPIRES_AT=
# Legacy (optional; not durable-synced on every refresh):
# JOBBER_ACCESS_TOKEN=
# QBO_ACCESS_TOKEN=
# QBO_EXPIRES_AT=

# Auto-save rotated *refresh* tokens to Render env (stops re-auth after every deploy).
# Only syncs when the refresh token value changes — avoids hourly redeploys.
# API key: https://dashboard.render.com/u/settings#api-keys
# Service ID: Render → your service → Settings (starts with srv-)
RENDER_API_KEY=
RENDER_SERVICE_ID=

# --- Bookkeeping email notify (Resend) ---
# Morning stage-only brief → numbered summary for approve-by-number in Cursor chat.
# Dashboard: https://resend.com/api-keys
RESEND_API_KEY=
# Bootstrap (no DNS): Resend test sender → account Gmail. Later use a verified domain.
RESEND_FROM=Veenstra Bookkeeping <onboarding@resend.dev>
# Alias also accepted: BOOKKEEPING_EMAIL_FROM=
BOOKKEEPING_NOTIFY_EMAIL=brevee12@gmail.com
# Later (after domain verify): BOOKKEEPING_NOTIFY_EMAIL=brennan@veenstrapainting.com
# Cursor agent/chat URL included in the email (§3) for approve-by-number replies
CURSOR_AGENT_URL=
# Optional alias: BOOKKEEPING_CURSOR_AGENT_URL=
# Optional shared secret for POST /bookkeeping/notify (header x-bookkeeping-notify-secret)
# BOOKKEEPING_NOTIFY_SECRET=
# Auto-maintained JSON array of SimpleFIN tx ids already staged/approved (dedupe across deploys)
# SIMPLEFIN_PROCESSED_IDS=[]

PORT=3001
